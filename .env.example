# Server Configuration
PORT=3000

# Database Configuration (Railway Postgres)
# Get this from your Railway dashboard
DATABASE_URL=postgresql://username:password@host:port/database

# OpenAI API Key
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Twilio Credentials
# Get these from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...

# SendGrid Credentials (for email responses)
# Get API key from: https://sendgrid.com/
# Email: Maddie's own Gmail (preferred, free). Google Account > Security > 2-Step Verification > App passwords.
GMAIL_APP_PASSWORD=
# GMAIL_USER=maddieweber7@gmail.com  (default)
SENDGRID_API_KEY=SG...
SENDGRID_FROM_EMAIL=your-email@gmail.com

# Morning digest: today's personal Google Calendar events by SMS + email, 7:30am ET
# Only schedule the daily job where this is exactly "true" (turn it on in Railway, not locally)
MORNING_DIGEST_ENABLED=false
# Google Calendar > Settings > your calendar > "Secret address in iCal format".
# It's a password for your calendar: never commit it or paste it anywhere public.
PERSONAL_CALENDAR_ICS_URL=
# Optional: your email on that calendar; events you declined are left out (default: maddieweber7@gmail.com)
CALENDAR_OWNER_EMAIL=
# Optional: phone number the digest is texted to (default: +17049997750)
DIGEST_TO_PHONE=

# Optional: public URL Twilio calls (only needed for a custom domain).
# Webhook signatures are checked against it. Example: https://my-app.up.railway.app
PUBLIC_BASE_URL=

# Claude (person matching + daily summary)
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
